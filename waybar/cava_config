
[general]
bars = 5 
framerate = 60
autosens = 1
sensitivity = 50
lower_cutoff_freq = 50
upper_cutoff_freq = 10000
method = pipewire
source = auto
bitrate = 16
stereo = stereo 
showbars = true
noise_reduction = 88

[smoothing]
# evita barras tremendo
gravity = 100
integral = 60
monstercat = 1
waves = 0

[output]
# modo de saída usado pelo script do Waybar
method = raw
raw_target = stdout
channels = 1
bit_format = ascii

[color]
foreground = 00FFAA
gradient = 1
gradient_color_1 = 00FFD2
gradient_color_2 = 00C8FF
gradient_color_3 = 0099FF
